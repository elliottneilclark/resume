---
import Hero from '../components/Hero.astro';
import IndexList, { type IndexItem } from '../components/IndexList.astro';
import SectionMarker from '../components/SectionMarker.astro';
import { cv } from '../data/cv';
import BaseLayout from '../layouts/BaseLayout.astro';
import styles from './index.module.css';

const projectItems: IndexItem[] = cv.projects.map((p) => ({
  label: p.name,
  href: p.link,
  external: true,
  tags: p.tags,
}));

const links = [
  { label: 'Email', href: `mailto:${cv.contact.email}`, external: false },
  ...cv.contact.socials.map((s) => ({
    label: s.name,
    href: s.url,
    external: true,
  })),
  { label: 'Writing', href: cv.contact.writing, external: true },
  { label: 'Consulting', href: cv.contact.consulting, external: true },
];
---
<BaseLayout image={cv.profile.photo}>
  <div class="container">
    <Hero />

    <nav class={styles.section} aria-labelledby="elsewhere-label">
      <SectionMarker as="h2" id="elsewhere-label">Elsewhere</SectionMarker>
      <div class={styles.links}>
        {links.map((l) => (
          <a
            class={styles.link}
            href={l.href}
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'noopener noreferrer' : undefined}
          >{l.label}</a>
        ))}
      </div>
    </nav>

    <section class={styles.section} aria-labelledby="projects-label">
      <SectionMarker as="h2" id="projects-label">Projects</SectionMarker>
      <div class={styles.body}><IndexList items={projectItems} /></div>
    </section>
  </div>
</BaseLayout>
