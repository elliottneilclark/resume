---
import { cv } from '../data/cv';
import styles from './SiteFooter.module.css';
import Wordmark from './Wordmark.astro';
---
<footer class={`${styles.footer} screen-only`}>
  <div class={`container ${styles.inner}`}>
    <div>
      <Wordmark soft />
      <p class={styles.tag}>Software engineer &amp; founder. Franklin, TN.</p>
    </div>
    <div><a class={styles.email} href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a></div>
  </div>
</footer>
