---
import { cv } from '../data/cv';
import ArrowLink from './ArrowLink.astro';
import styles from './Hero.module.css';

const { name, tagline, photo } = cv.profile;
const about = cv.about;
---
<section class={styles.hero}>
  <div class:list={['reveal', styles.masthead]} style="--reveal-order: 0">
    <div class={styles.identity}>
      <h1 class={styles.name}>{name}</h1>
      <p class={styles.tagline}>{tagline}</p>
    </div>
    <img class={styles.photo} src={photo} width="192" height="192" alt={`Portrait of ${name}`} loading="eager" />
  </div>
  <p class:list={['reveal', styles.about]} style="--reveal-order: 1">{about}</p>
  <div class:list={['reveal', styles.actions]} style="--reveal-order: 2">
    <ArrowLink href="/resume">View full résumé</ArrowLink>
  </div>
</section>
